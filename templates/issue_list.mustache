{{!
    @template mod_pagecheck/issue_list

    The problems found with a submission.

    Rendered on the server when the activity page loads, and again in the browser by
    mod_pagecheck/validator as soon as the student picks a file, so that both say the same thing
    in the same words.

    Context variables required for this template:
    * issues - array of problems, each with a message and an iserror flag
    * checking - whether some file is still being checked

    Example context (json):
    {
        "issues": [
            {"message": "report.pdf: the document has 3 pages, but at least 5 are required.",
             "iserror": true},
            {"message": "report.pdf: 2 blank pages were found.", "iserror": false}
        ],
        "checking": false
    }
}}
<div class="pagecheck-issues" role="status" aria-live="polite">
    {{#checking}}
        <div class="alert alert-info" role="alert">
            {{#pix}}i/loading_small, core{{/pix}}
            {{#str}}checkingfile, mod_pagecheck{{/str}}
        </div>
    {{/checking}}
    {{#issues}}
        <div class="alert {{#iserror}}alert-danger{{/iserror}}{{^iserror}}alert-warning{{/iserror}}"
             role="alert">
            {{message}}
        </div>
    {{/issues}}
</div>
