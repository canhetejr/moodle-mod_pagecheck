{{!
    @template mod_pagecheck/submission_status

    What the student sees on the activity page: the restrictions that apply to them, the state of
    their attempt, and every file with its page count.

    Context variables required for this template:
    * status - rows describing the state of the attempt
    * restrictions - rows describing the rules in force
    * files - the submitted files with their page counts
    * hasfiles - whether there is at least one file

    Example context (json):
    {
        "status": [{"label": "Submission status", "value": "Submitted for grading"}],
        "restrictions": [{"label": "Pages", "value": "Between 5 and 10"}],
        "hasfiles": true,
        "files": [
            {"filename": "report.pdf", "url": "https://example.com/report.pdf",
             "pages": "7", "size": "1.2 MB", "method": "PDF structure", "iserror": false}
        ]
    }
}}
<div class="pagecheck-status">
    <table class="generaltable table table-sm">
        <caption class="sr-only">{{#str}}submissionstatus, mod_pagecheck{{/str}}</caption>
        <tbody>
            {{#status}}
                <tr>
                    <th scope="row" class="cell c0">{{label}}</th>
                    <td class="cell c1">{{{value}}}</td>
                </tr>
            {{/status}}
        </tbody>
    </table>

    <h3>{{#str}}restrictions, mod_pagecheck{{/str}}</h3>
    <table class="generaltable table table-sm">
        <caption class="sr-only">{{#str}}restrictions, mod_pagecheck{{/str}}</caption>
        <tbody>
            {{#restrictions}}
                <tr>
                    <th scope="row" class="cell c0">{{label}}</th>
                    <td class="cell c1">{{value}}</td>
                </tr>
            {{/restrictions}}
        </tbody>
    </table>

    {{#hasfiles}}
        <h3>{{#str}}submittedfiles, mod_pagecheck{{/str}}</h3>
        <table class="generaltable table table-sm">
            <caption class="sr-only">{{#str}}submittedfiles, mod_pagecheck{{/str}}</caption>
            <thead>
                <tr>
                    <th scope="col">{{#str}}file, mod_pagecheck{{/str}}</th>
                    <th scope="col">{{#str}}pages, mod_pagecheck{{/str}}</th>
                    <th scope="col">{{#str}}size, mod_pagecheck{{/str}}</th>
                    <th scope="col">{{#str}}countmethod, mod_pagecheck{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#files}}
                    <tr class="{{#iserror}}table-danger{{/iserror}}">
                        <td><a href="{{url}}">{{filename}}</a></td>
                        <td>{{pages}}</td>
                        <td>{{size}}</td>
                        <td>{{method}}</td>
                    </tr>
                {{/files}}
            </tbody>
        </table>
    {{/hasfiles}}
</div>
