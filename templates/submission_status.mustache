{{!
    @template mod_pagecheck/submission_status

    What the student sees on the activity page: how many pages they have against how many were
    asked for, the state of the attempt, the rules in force, and every file with its page count.

    The page count leads, because it is the one thing this activity does that the assignment
    activity does not, and it is the thing a student needs to see without reading a table.

    Context variables required for this template:
    * statuslabel, statusstate - the state of the attempt and which pill to draw
    * timeline - the three steps a submission goes through, and where the student is
    * allclear - whether there is a submission with nothing wrong with it
    * meter - the page count against the required range
    * facts - dates and other rows about the attempt
    * restrictions - the rules in force for this student
    * files, hasfiles - the submitted files with their page counts
    * emptyimage, emptytext - what to show before anything is attached

    Example context (json):
    {
        "statuslabel": "Submitted for grading",
        "statusstate": "ok",
        "allclear": true,
        "timeline": [
            {"label": "Draft", "state": "done", "hint": "done", "number": 1},
            {"label": "Submitted", "state": "current", "hint": "current step", "number": 2},
            {"label": "Graded", "state": "todo", "hint": "still to come", "number": 3}
        ],
        "meter": {
            "show": true, "value": "7", "unit": "pages", "state": "ok",
            "hasrange": true, "rangetext": "Between 5 and 10", "caption": "Within the range.",
            "percent": 70, "bandleft": 50, "bandwidth": 50, "scalemin": "0", "scalemax": "10",
            "ticks": [{"percent": 50, "label": "min 5"}, {"percent": 100, "label": "max 10"}]
        },
        "facts": [{"label": "Due date", "value": "1 September 2026"}],
        "restrictions": [{"label": "Pages", "value": "Between 5 and 10"}],
        "hasfiles": true,
        "emptyimage": "https://example.com/nosubmission.svg",
        "emptytext": "Nothing attached yet.",
        "files": [
            {"filename": "report.pdf", "url": "https://example.com/report.pdf",
             "pages": "7", "size": "1.2 MB", "method": "PDF page tree",
             "papersize": "A4", "iserror": false}
        ]
    }
}}
<div class="pagecheck-status">

    <div class="pagecheck-panel">
        <div class="pagecheck-panel__head">
            <h3 class="pagecheck-panel__title">{{#str}}submissionstatus, mod_pagecheck{{/str}}</h3>
            <span class="pagecheck-pill pagecheck-pill--{{statusstate}}">{{statuslabel}}</span>
        </div>
        <div class="pagecheck-panel__body">
            <ol class="pagecheck-steps" aria-label="{{#str}}timeline, mod_pagecheck{{/str}}">
                {{#timeline}}
                    <li class="pagecheck-step is-{{state}}">
                        <span class="pagecheck-step__marker" aria-hidden="true">{{number}}</span>
                        <span class="pagecheck-step__label">{{label}}</span>
                        <span class="sr-only">{{hint}}</span>
                    </li>
                {{/timeline}}
            </ol>

            {{#meter}}
                {{#show}}
                    <div class="pagecheck-hero">
                        <div class="pagecheck-count pagecheck-count--{{state}}">
                            <span class="pagecheck-count__value">{{value}}</span>
                            <span class="pagecheck-count__label">{{unit}}</span>
                        </div>
                        <div class="pagecheck-gauge pagecheck-gauge--{{state}}">
                            {{#hasrange}}
                                <div class="pagecheck-gauge__track">
                                    <div class="pagecheck-gauge__band"
                                         style="left: {{bandleft}}%; width: {{bandwidth}}%;"></div>
                                    <div class="pagecheck-gauge__fill" style="--pagecheck-fill: {{percent}}%;"></div>
                                    {{#ticks}}
                                        <span class="pagecheck-gauge__tick" style="left: {{percent}}%;"></span>
                                    {{/ticks}}
                                </div>
                                <div class="pagecheck-gauge__scale">
                                    <span>{{scalemin}}</span>
                                    {{#ticks}}
                                        <span class="pagecheck-gauge__ticklabel"
                                              style="left: {{percent}}%;">{{label}}</span>
                                    {{/ticks}}
                                    <span>{{scalemax}}</span>
                                </div>
                            {{/hasrange}}
                            <p class="pagecheck-gauge__caption">{{caption}}</p>
                        </div>
                    </div>
                {{/show}}
            {{/meter}}

            {{#allclear}}
                <p class="pagecheck-allclear">{{#str}}checkspassed, mod_pagecheck{{/str}}</p>
            {{/allclear}}

            {{#hasfacts}}
                <dl class="pagecheck-facts">
                    {{#facts}}
                        <dt>{{label}}</dt>
                        <dd>{{{value}}}</dd>
                    {{/facts}}
                </dl>
            {{/hasfacts}}
        </div>
    </div>

    <div class="pagecheck-panel">
        <div class="pagecheck-panel__head">
            <h3 class="pagecheck-panel__title">{{#str}}restrictions, mod_pagecheck{{/str}}</h3>
        </div>
        <div class="pagecheck-panel__body">
            <dl class="pagecheck-facts">
                {{#restrictions}}
                    <dt>{{label}}</dt>
                    <dd>{{value}}</dd>
                {{/restrictions}}
            </dl>
        </div>
    </div>

    <div class="pagecheck-panel">
        <div class="pagecheck-panel__head">
            <h3 class="pagecheck-panel__title">{{#str}}submittedfiles, mod_pagecheck{{/str}}</h3>
        </div>
        {{#hasfiles}}
            <div class="pagecheck-panel__body">
                <table class="pagecheck-files">
                    <caption class="sr-only">{{#str}}submittedfiles, mod_pagecheck{{/str}}</caption>
                    <thead>
                        <tr>
                            <th scope="col">{{#str}}file, mod_pagecheck{{/str}}</th>
                            <th scope="col">{{#str}}pages, mod_pagecheck{{/str}}</th>
                            <th scope="col">{{#str}}papersize, mod_pagecheck{{/str}}</th>
                            <th scope="col">{{#str}}size, mod_pagecheck{{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#files}}
                            <tr class="{{#iserror}}is-error{{/iserror}}">
                                <td><a href="{{url}}">{{filename}}</a></td>
                                <td>
                                    {{pages}}
                                    <span class="pagecheck-files__meta">{{method}}</span>
                                </td>
                                <td>{{papersize}}</td>
                                <td>{{size}}</td>
                            </tr>
                        {{/files}}
                    </tbody>
                </table>
            </div>
        {{/hasfiles}}
        {{^hasfiles}}
            <div class="pagecheck-empty">
                <img src="{{emptyimage}}" alt="">
                <p>{{emptytext}}</p>
            </div>
        {{/hasfiles}}
    </div>
</div>
